@startuml
!theme plain

' Configuration
skinparam linetype ortho
hide circle

' Actors
actor Customer
actor Admin
actor "Payment Gateway" as Payment

' Frontend Components
rectangle "Frontend UI" as FrontendUI {
}

' Backend Components
rectangle "User Actions Handler" as UserActions {
}
rectangle "Menu Management" as MenuMgmt {
}
rectangle "Order Management" as OrderMgmt {
}
rectangle "Payment Processor" as PaymentProc {
}

' Data Management
rectangle "Prisma ORM" as Prisma {
}
database "PostgreSQL" as Database

' Payment
rectangle "Razorpay Integration" as Razorpay {
}

' Customer Interactions
Customer -down-> FrontendUI : Views Pages
FrontendUI -down-> UserActions : Actions

' Admin Interactions
Admin -down-> FrontendUI : Manages
FrontendUI -down-> MenuMgmt : Menu Ops
FrontendUI -down-> OrderMgmt : Order Ops

' System Operations
UserActions -down-> Prisma : CRUD Ops
MenuMgmt -down-> Prisma : CRUD Ops
OrderMgmt -down-> Prisma : CRUD Ops
Prisma -down-> Database : Data Storage

' Payment Flow
UserActions -right-> PaymentProc : Initiate Payment
' PaymentProc -right-> Payment : Process
' Payment -right-> PaymentProc : Confirm
PaymentProc -down-> Razorpay : Use
Razorpay -up-right-> PaymentProc : Confirm

' Notes for clarity
note right of FrontendUI
  Next.js 14, Tailwind CSS, Shadcn UI
end note

note right of UserActions
  Serverless Functions
end note

note right of Prisma
  ORM Interface
end note

note right of Database
  Serverless PostgreSQL
end note

note right of Razorpay
  Payment Processing
end note

@enduml