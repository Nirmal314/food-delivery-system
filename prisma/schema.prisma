generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum Cuisine {
  ITALIAN
  NORTH_INDIAN
  PUNJABI
  SOUTH_INDIAN
  GUJARATI
  CHINESE
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @unique
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Restaurant {
  id          String  @id @default(cuid())
  adminId     String  @unique
  name        String
  cuisine     Cuisine
  address     String
  phone       String
  description String?
  admin       User?   @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String?     @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole    @default(USER)
  contactNumber String      @default(dbgenerated("1234567890"))
  // ? there might not be a related record in the associated model. In database terms, it translates to a nullable foreign key.
  accounts      Account? // ! one user can have a google account 
  restaurant    Restaurant? // ! one admin can have one restaurant 
}
